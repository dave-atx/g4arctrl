{
	"luci-app-tmog4ar": {
		"description": "Grant access to the tmog4ar cellular gateway status, history and settings",
		"read": {
			"file": {
				"/tmp/tmog4ar-0/latest.json": [ "read" ],
				"/usr/bin/tmog4ar status --json --max-age *": [ "exec" ],
				"/usr/bin/tmog4ar history --json -s *": [ "exec" ]
			},
			"uci": [ "tmog4ar" ]
		},
		"write": {
			"file": {
				"/usr/bin/tmog4ar reboot --force": [ "exec" ]
			},
			"uci": [ "tmog4ar" ]
		}
	}
}
