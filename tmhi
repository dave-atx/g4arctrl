# history --json: the same numbers for a UI to draw. Everything is unix time;
# buckets start at local midnight / hour boundaries (tzoff = local - UTC).
#   bands     time on each band, most first: key, good, samples, rsrp, sinr
#   towers    time on each tower, most first: radio, id, samples, good, rsrp, sinr
#   hours     per hour: t, n, good, rsrp/sinr [avg, min, max], keys {key: samples}
#   series    per bucket: [t, n, good, rsrp [avg, min, max], sinr [avg, min, max]]
#   segments  runs on one band: [start, end, key, good]; a gap ends a run
#   events    band and tower changes, gaps and gateway reboots, oldest first
#             (the last maxev); a change of tower has nb_from / nb_to and
#             radio_from / radio_to; a reboot (type "reboot") has source
#             (auto|manual), result (ok|noanswer|failed) and from (the band)
# shellcheck disable=SC2016 # awk program, not shell
AWK_HISTORY_JSON='
$1 + 0 < since { next }
{
	t = $1 + 0; n++
	if (!t0) t0 = t
	k = key(); g = good()
	if (!(k in cnt)) ord[++nk] = k
	cnt[k]++; kg[k] = g
	rp = f("nr_rsrp"); if (rp == "-") rp = f("lte_rsrp")
	sn = f("nr_sinr"); if (sn == "-") sn = f("lte_sinr")
	if (rp != "-") { krp[k] += rp; krn[k]++ }
	if (sn != "-") { ksn[k] += sn; ksnn[k]++ }

	h = int((t + tzoff) / 3600) * 3600 - tzoff
	if (!(("h" SUBSEP h) in N)) hord[++nh] = h
	acc("h" SUBSEP h); hk[h, k]++
	b = int((t + tzoff) / bucket) * bucket - tzoff
	if (!(("b" SUBSEP b) in N)) bord[++nb] = b
	acc("b" SUBSEP b)

	tower = servtower(); rad = TRAD
	if (tower != "-") {
		tk = rad SUBSEP tower
		if (!(tk in tcnt)) { tord[++ntw] = tk; trad[tk] = rad; tid[tk] = tower }
		tcnt[tk]++; if (g) tgood[tk]++
		if (rp != "-") { trp[tk] += rp; trn[tk]++ }
		if (sn != "-") { tsn[tk] += sn; tsnn[tk]++ }
	}
	if (n == 1) seg(t)
	else if (t - pt > gap) { se[ns] = pt + ivl; ev(pt, "gap", "", "", 0, 0, "", "", t - pt); seg(t) }
	else if (k != pk) { se[ns] = t; seg(t) }
	while ((r = rbnext(t))) rbev(r)
	if (n > 1) {
		moved = (tower != ptower && tower != "-" && ptower != "-")
		if (k != pk) ev(t, "band", pk, k, pg, g, moved ? ptower : "", moved ? tower : "", 0)
		else if (moved) ev(t, "tower", k, k, g, g, ptower, tower, 0)
	}
	pt = t; pk = k; pg = g; ptower = tower; prad = rad; t1 = t
}
function acc(id) {
	N[id]++; if (g) G[id]++
	if (rp != "-") { rp += 0; RSUM[id] += rp; RCNT[id]++
		if (!(id in RLO) || rp < RLO[id]) RLO[id] = rp
		if (!(id in RHI) || rp > RHI[id]) RHI[id] = rp }
	if (sn != "-") { sn += 0; SSUM[id] += sn; SCNT[id]++
		if (!(id in SLO) || sn < SLO[id]) SLO[id] = sn
		if (!(id in SHI) || sn > SHI[id]) SHI[id] = sn }
}
function seg(t) { ns++; s0[ns] = t; sk[ns] = k; sg[ns] = g }
function js(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return "\"" s "\"" }
function tf(x) { return x ? "true" : "false" }
function avg(s, c) { return c ? sprintf("%.1f", s / c) : "null" }
function stat3(id, S, C, L, H) { return (id in C) ? sprintf("[%.1f,%s,%s]", S[id] / C[id], L[id], H[id]) : "null" }
function ev(t, type, a, b, ga, gb, na, nbb, d,   s) {
	s = "{\"t\":" t ",\"type\":\"" type "\""
	if (type == "gap") s = s ",\"dur\":" d
	else {
		s = s ",\"from\":" js(a) ",\"to\":" js(b) ",\"from_good\":" tf(ga) ",\"to_good\":" tf(gb)
		if (na != "") s = s ",\"nb_from\":" js(na) ",\"nb_to\":" js(nbb) ",\"radio_from\":" js(prad) ",\"radio_to\":" js(rad)
	}
	E[++ne] = s "}"
}
function rbev(r) {
	E[++ne] = "{\"t\":" RBT[r] ",\"type\":\"reboot\",\"source\":" js(RBS[r]) ",\"result\":" js(RBR[r]) ",\"from\":" js(RBK[r]) "}"
}
END {
	while ((r = rbnext(now))) rbev(r)
	if (n) se[ns] = t1 + ivl
	printf "{\"now\":%d,\"since\":%d,\"first\":%s,\"last\":%s,\"samples\":%d,", now, since, (n ? t0 : "null"), (n ? t1 : "null"), n
	printf "\"bucket\":%d,\"interval\":%d,\"gap\":%d,\"tzoff\":%d,\"min_bw\":%d,\"stuck_minutes\":%d,\"preferred\":[", bucket, ivl, gap, tzoff, minbw, stuck
	sep = ""; for (i = 1; i <= npref; i++) if (P[i] != "") { printf "%s%s", sep, js(P[i]); sep = "," }

	for (i = 1; i <= nk; i++) for (j = i + 1; j <= nk; j++) if (cnt[ord[j]] > cnt[ord[i]]) { x = ord[i]; ord[i] = ord[j]; ord[j] = x }
	printf "],\"bands\":["
	for (i = 1; i <= nk; i++) {
		k = ord[i]
		printf "%s{\"key\":%s,\"good\":%s,\"samples\":%d,\"rsrp\":%s,\"sinr\":%s}", (i > 1 ? "," : ""), js(k), tf(kg[k]), cnt[k], avg(krp[k], krn[k]), avg(ksn[k], ksnn[k])
	}

	printf "],\"towers\":["
	for (i = 1; i <= ntw; i++) for (j = i + 1; j <= ntw; j++) if (tcnt[tord[j]] > tcnt[tord[i]]) { x = tord[i]; tord[i] = tord[j]; tord[j] = x }
	for (i = 1; i <= ntw; i++) {
		tk = tord[i]
		printf "%s{\"radio\":%s,\"id\":%s,\"samples\":%d,\"good\":%d,\"rsrp\":%s,\"sinr\":%s}", (i > 1 ? "," : ""), js(trad[tk]), js(tid[tk]), tcnt[tk], tgood[tk], avg(trp[tk], trn[tk]), avg(tsn[tk], tsnn[tk])
	}

	printf "],\"hours\":["
	for (i = 1; i <= nh; i++) {
		h = hord[i]; id = "h" SUBSEP h
		printf "%s{\"t\":%d,\"n\":%d,\"good\":%d,\"rsrp\":%s,\"sinr\":%s,\"keys\":{", (i > 1 ? "," : ""), h, N[id], G[id], stat3(id, RSUM, RCNT, RLO, RHI), stat3(id, SSUM, SCNT, SLO, SHI)
		sep = ""; for (j = 1; j <= nk; j++) if ((h, ord[j]) in hk) { printf "%s%s:%d", sep, js(ord[j]), hk[h, ord[j]]; sep = "," }
		printf "}}"
	}

	printf "],\"series\":["
	for (i = 1; i <= nb; i++) {
		b = bord[i]; id = "b" SUBSEP b
		printf "%s[%d,%d,%d,%s,%s]", (i > 1 ? "," : ""), b, N[id], G[id], stat3(id, RSUM, RCNT, RLO, RHI), stat3(id, SSUM, SCNT, SLO, SHI)
	}

	printf "],\"segments\":["
	for (i = 1; i <= ns; i++) printf "%s[%d,%d,%s,%s]", (i > 1 ? "," : ""), s0[i], se[i], js(sk[i]), tf(sg[i])

	printf "],\"events\":["
	for (i = (ne > maxev ? ne - maxev + 1 : 1); i <= ne; i++) printf "%s%s", (i > (ne > maxev ? ne - maxev + 1 : 1) ? "," : ""), E[i]
	printf "]}\n"
}
'

# json_bucket SECS: a chart bucket that gives at most ~360 points over SECS
json_bucket() {
	local b
	for b in 300 600 900 1800 3600 7200 10800 21600 43200 86400; do
		if [ $(($1 / b)) -le 360 ]; then break; fi
	done
	echo "$b"
}

cmd_history() {
	local since=86400 bucket='' raw=0 json=0
	while [ $# -gt 0 ]; do
		case "$1" in
		-s | --since)
			[ $# -ge 2 ] || die "missing value for $1"
			since=$(dur_secs "$2")
			shift 2
			;;
		-b | --bucket)
			[ $# -ge 2 ] || die "missing value for $1"
			bucket=$(dur_secs "$2")
			shift 2
			;;
		--raw) shift && raw=1 ;;
		--json) shift && json=1 ;;
		*) die "unknown option: $1" ;;
		esac
	done
	TS=$(date +%s)
	init
	if [ "$json" = 1 ]; then
		# No history yet is an empty result here, not an error.
		if [ -z "$bucket" ]; then bucket=$(json_bucket "$since"); fi
		[ "$bucket" -gt 0 ] || die "bucket must be positive"
		awk_env
		history_cat $((TS - since)) | run_awk "$AWK_HISTORY_JSON" -v since="$((TS - since))" -v now="$TS" -v eventfile="$EVENTS" \
			-v bucket="$bucket" -v ivl=60 -v maxev=500 -v stuck="$STUCK_MINUTES"
		return 0
	fi
	has_history || die "no history in $HISTORY_DIR yet (see: tmhi help)"
	if [ "$raw" = 1 ]; then
		history_cat $((TS - since)) | awk -F '\t' -v c="$((TS - since))" '$1 == "ts" ? !h++ : $1 >= c'
		return 0
	fi
	if [ -z "$bucket" ]; then
		if [ "$since" -gt 172800 ]; then bucket=86400; else bucket=3600; fi
	fi
	[ "$bucket" -gt 0 ] || die "bucket must be positive"
	awk_env
	history_cat $((TS - since)) | run_awk "$AWK_HISTORY" -v since="$((TS - since))" -v now="$TS" -v eventfile="$EVENTS" -v bucket="$bucket" -v maxev=25 \
		-v B="$BOLD" -v DIM="$DIM" -v RST="$RESET" -v GRN="$GREEN" -v YEL="$YELLOW" -v RED="$RED"
}

cmd_reboot() {
	local force=0 answer
	case "${1:-}" in
	-f | --force) force=1 ;;
	'') ;;
	*) die "unknown option: $1" ;;
	esac
	[ -n "$ADMIN_PASS" ] || die "reboot needs the admin password (tmhi.main.password)"
	init
	awk_env
	collect
	[ -z "$FETCH_ERR" ] || die "$FETCH_ERR"
	health_eval
	printf '%s\n' "$H_msg"
	if [ "$force" = 0 ]; then
		[ -t 0 ] || die "not a terminal; pass --force to reboot without confirming"
		printf 'Reboot the gateway at %s (up %s)? [y/N] ' "$HOST" "$(fmt_dur "${S_uptime:-}")"
		read -r answer || answer=''
		case "$answer" in
		y | Y | yes | YES) ;;
		*)
			echo "Not rebooting."
			return 0
			;;
		esac
	fi
	if ! gw_reboot force; then
		event_log manual failed
		syslog warning "Manual reboot of the gateway failed: $REBOOT_ERR"
		die "reboot failed: $REBOOT_ERR"
	fi
	if [ "$REBOOT_CODE" = 000 ]; then
		event_log manual noanswer
		syslog notice "Manual reboot of the gateway requested, no answer (was on ${H_key:-unknown})"
		die "no response to the reboot request (the gateway may already be restarting)"
	fi
	event_log manual ok
	syslog notice "Manual reboot of the gateway requested (was on ${H_key:-unknown})"
	echo "Reboot requested. The gateway usually takes a few minutes to come back."
}

cmd_raw() {
	local code
	init
	case "${1:-gateway}" in
	gateway)
		code=$(http_get 'gateway/?get=all' "$TMP/out.json")
		case "$code" in 2??) ;; *) die "HTTP $code from gateway" ;; esac
		;;
	cell)
		auth_get 'network/telemetry/?get=cell' "$TMP/out.json" ||
			die "could not read cell telemetry (needs tmhi.main.password)"
		;;
	*) die "raw: expected gateway or cell" ;;
	esac
	jq . "$TMP/out.json"
}

usage() {
	cat <<EOF
Usage: tmhi [command] [options]

Commands:
  status [--json] [--max-age SECS]
                       Band, channel width, signal quality and health (default
                       command). With --max-age, a sample at most SECS old
                       (usually the service's) is printed instead of asking
                       the gateway again
  watch [-i SECS]      Live view, refreshed every SECS seconds (default 15, min 5)
  health               Is the gateway stuck? Exit 0 ok, 2 degraded,
                       3 reboot recommended, 1 unreachable
  daemon [-i SECS]     Record a sample every SECS seconds (default 60); this is
                       what the tmhi service runs. Samples are buffered in RAM
                       and written to flash every flush_minutes
  log                  Record one sample (for cron, if you'd rather not run the service)
  flush                Write buffered samples to flash now
  version              Print the version
  history [-s DUR] [-b DUR] [--raw | --json]
                       Time per band, quality per hour or day, and band/tower
                       changes over the last DUR (90m, 24h, 7d; default 24h)
  reboot [--force]     Reboot the gateway (asks first unless --force)
  notify-test          Send a test notification (see Notifications below)
  raw [gateway|cell]   Print the gateway's raw JSON

Settings are UCI options in /etc/config/tmhi, section "main":
  password        admin password; needed for channel width, PCI/ARFCN/CQI and
                  reboot. Keep the file mode 600.
  username        admin username (admin)
  host            gateway address (192.168.12.1)
  port            API port (8080)
  timeout         request timeout in seconds (10)
  preferred_band  a band that counts as healthy; a list (n41)
  min_bw          narrowest healthy channel in MHz (40)
  stuck_minutes   minutes off the preferred band before a reboot is
                  recommended (30)
  history_dir     where daily history files go (/etc/tmhi)
  retention_days  days of history to keep (30)
  flush_minutes   how often buffered samples go to flash (60; 0 = every
                  sample). A crash or power cut loses at most this much.
  units           imperial (mi) or metric (km) for tower distances (imperial)
  auto_reboot     1 = reboot the gateway by itself at night when a reboot is
                  recommended (0). Needs the password. At most one attempt a
                  night, and only while the WAN is quiet:
  auto_reboot_start, auto_reboot_end
                  the night window, hours in router local time; the end hour
                  isn't included (2 and 5: 02:00 - 04:59)
  auto_reboot_idle_kbit
                  quiet = under this many kbit/s each way, per minute (1000)
  auto_reboot_idle_minutes
                  for at least this long (15)
  wan_device      the device to measure (default, or if it doesn't exist: the wan interface's)

Towers can be named, one "tower" section each, so output says "Water tower
· 1.3 mi NE (42°)" rather than a bare gNB number (LuCI: Status > Cellular,
or Settings > Towers):
  uci add tmhi tower
  uci set tmhi.@tower[-1].radio=nr          # nr = 5G gNB, lte = 4G eNB
  uci set tmhi.@tower[-1].id=1234567
  uci set tmhi.@tower[-1].name='Water tower'
  uci set tmhi.@tower[-1].lat=47.6101 tmhi.@tower[-1].lon=-122.2015
  uci commit tmhi
For example:
  uci set tmhi.main.password='...' && uci commit tmhi

Notifications: tmhi logs to syslog, sends a ubus event ("ubus listen
tmhi") and runs the scripts in /etc/hotplug.d/tmhi/ when a reboot
becomes recommended, when it recovers after that, and before / after an
automatic reboot. It sends nothing off the router itself; a hotplug script
can (curl to ntfy, a webhook, etc). Scripts get ACTION (reboot-recommended,
recovered, auto-reboot, auto-reboot-done, test), MESSAGE, LEVEL, BAND, WHY
and DURATION (seconds degraded). See /etc/hotplug.d/tmhi/50-example.
The system log also notes the gateway not answering (and back), and manual
reboots.

Health: a sample is good when the gateway is registered on a preferred band
and, if the width is known, at least min_bw MHz wide. Brief drops are normal
handovers. A reboot is recommended once samples have been bad for
stuck_minutes and a good sample was seen in the past week.

History logging on OpenWrt: the tmhi service (/etc/init.d/tmhi) runs
"tmhi daemon". It takes a sample a minute (about 3 MB a month), writes to
flash in one append an hour, and saves the buffer when stopped or at reboot.
It restarts by itself when /etc/config/tmhi changes and is reloaded
(LuCI does that; from a shell: reload_config).
EOF
}

main() {
	local cmd="${1:-status}"
	if [ $# -gt 0 ]; then shift; fi
	case "$cmd" in
	status) cmd_status "$@" ;;
	watch) cmd_watch "$@" ;;
	health) cmd_health "$@" ;;
	log) cmd_log "$@" ;;
	daemon) cmd_daemon "$@" ;;
	version | --version) echo "tmhi $VERSION" ;;
	flush) cmd_flush "$@" ;;
	history) cmd_history "$@" ;;
	reboot) cmd_reboot "$@" ;;
	notify-test) cmd_notify_test "$@" ;;
	raw) cmd_raw "$@" ;;
	help | -h | --help) usage ;;
	*)
		err "unknown command: $cmd"
		usage >&2
		exit 1
		;;
	esac
}

main "$@"
