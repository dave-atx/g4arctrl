# tmhi settings. Installed as /etc/config/tmhi (mode 600: it holds the
# gateway's admin password). Edit in LuCI (Status > Cellular > Settings) or with
# uci, e.g.:
#   uci set tmhi.main.password='your-password' && uci commit tmhi && reload_config

config tmhi 'main'
	# Gateway admin password. Needed for channel width, PCI / ARFCN / CQI and reboot.
	#option password ''
	option username 'admin'
	option host '192.168.12.1'
	option port '8080'
	option timeout '10'

	# What counts as healthy, and how long it can be unhealthy before a
	# reboot is recommended.
	list preferred_band 'n41'
	option min_bw '40'
	option stuck_minutes '30'

	# Reboot the gateway by itself when a reboot is recommended (needs the
	# password): only between auto_reboot_start and auto_reboot_end (hours,
	# router local time, end not included), only once the WAN has been under
	# auto_reboot_idle_kbit both ways for auto_reboot_idle_minutes, and at most
	# once a night. wan_device defaults to the wan interface's device, which
	# is also used if the named device doesn't exist.
	option auto_reboot '0'
	option auto_reboot_start '2'
	option auto_reboot_end '5'
	option auto_reboot_idle_kbit '1000'
	option auto_reboot_idle_minutes '15'
	#option wan_device ''

	# History
	option history_dir '/etc/tmhi'
	option retention_days '30'
	option flush_minutes '60'
	option units 'imperial'      # tower distances in mi; 'metric' for km

# Named towers (optional), one section each. LuCI adds these from the status
# page ("Name it…" next to the tower number).
#config tower
#	option radio 'nr'            # nr = 5G gNB, lte = 4G eNB
#	option id '1234567'
#	option name 'Water tower'
#	option lat '47.6101'
#	option lon '-122.2015'
