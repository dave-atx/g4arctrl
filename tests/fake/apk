#!/bin/sh
# Fake apk: `apk version -t A B` prints <, = or >; `apk ... add PKG...` is
# recorded in $T/apk.
case " $* " in *" add "*)
	args=" $* "
	echo "add ${args##* add }" | sed "s/ *$//" >>"$T/apk"
	exit 0
	;;
esac
[ "$1 $2" = "version -t" ] || exit 1
if [ "$3" = "$4" ]; then
	echo '='
elif [ "$(printf '%s\n%s\n' "$3" "$4" | sort -t. -k1,1n -k2,2n -k3,3n | head -n 1)" = "$3" ]; then
	echo '<'
else
	echo '>'
fi
